set ignore-comments

specs_dir := justfile_directory() / 'src/ein_utcp/specs'

# Prometheus generates its spec at build time; pinned to a commit on main so the file is reproducible.
prometheus_version := '3.5.0'
prometheus_commit := '75f94903b36d11b7b47dc3e0ebabab1ce3acabc7'
prometheus_url := 'https://raw.githubusercontent.com/prometheus/prometheus/' + prometheus_commit + '/web/api/v1/testdata/openapi_3.1_golden.yaml'
alertmanager_version := '0.34.1'
alertmanager_url := 'https://raw.githubusercontent.com/prometheus/alertmanager/v' + alertmanager_version + '/api/v2/openapi.yaml'

[doc('Describe usage and list the available recipes.')]
help:
    @just --list --unsorted

[doc('Download every spec that has an upstream. Loki has none: its spec is written by hand.')]
download: download-prometheus download-alertmanager
    @echo "specs in {{ specs_dir }}"

[doc('Download the Prometheus HTTP API spec. Override the pin: just download-prometheus prometheus_version=3.6.0 prometheus_commit=<sha>')]
download-prometheus:
    @mkdir -p {{ specs_dir }}/prometheus
    curl -fsSL -o {{ specs_dir }}/prometheus/{{ prometheus_version }}.yaml {{ prometheus_url }}
    @echo "wrote specs/prometheus/{{ prometheus_version }}.yaml"

[doc('Download the Alertmanager v2 API spec. Override: just download-alertmanager alertmanager_version=0.35.0')]
download-alertmanager:
    @mkdir -p {{ specs_dir }}/alertmanager
    curl -fsSL -o {{ specs_dir }}/alertmanager/{{ alertmanager_version }}.yaml {{ alertmanager_url }}
    @echo "wrote specs/alertmanager/{{ alertmanager_version }}.yaml"

[doc('Unit tests of the package alone.')]
test *args:
    uv run --group test pytest tests/unit {{ args }}
